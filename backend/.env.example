# Скопировать в .env для локального запуска.
# Имя БД/роли (softrent_dev) — внутренний инфра-идентификатор, не бренд.
DATABASE_URL="postgresql://openrent:openrent@localhost:5432/openrent?schema=public"
REDIS_URL="redis://localhost:6379"

# Каталог локального файлового хранилища (LocalFsStorageProvider, ADR-0007).
UPLOADS_DIR="./uploads"

# JWT (ADR-0006). В проде — секреты из окружения хостинга, не в репозитории.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000

# Разрешённые origin'ы фронтенда для CORS (через запятую). Пусто в dev =
# отражать любой origin. В проде — явный список доменов (softrent.ru).
CORS_ORIGIN="http://localhost:3001"
# Прод-пример: CORS_ORIGIN="https://softrent.ru,https://www.softrent.ru"

# Field-level шифрование ПДн сторон договора (CryptoService, ADR-0021).
# 32 байта = 64 hex-символа. В проде — секрет из окружения хостинга, не
# в репозитории. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="dev-encryption-key-change-me-0000000000000000000000000000"
